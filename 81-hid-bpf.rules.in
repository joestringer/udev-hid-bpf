ACTION!="add|remove|bind|unbind", GOTO="hid_bpf_end"
SUBSYSTEM!="hid", GOTO="hid_bpf_end"

IMPORT{builtin}="hwdb --subsystem=hid --lookup-prefix=hid-bpf:"

ACTION=="add", ENV{.HID_BPF}=="1", IMPORT{program}+="@BINDIR@/udev-hid-bpf add $sys$devpath"
ACTION=="remove", ENV{.HID_BPF}=="1", RUN{program}+="@BINDIR@/udev-hid-bpf remove $sys$devpath"
ACTION=="bind|unbind", ENV{.HID_BPF}=="1", IMPORT{program}+="@BINDIR@/udev-hid-bpf list-loaded --format udev --syspath $sys$devpath"

LABEL="hid_bpf_end"
